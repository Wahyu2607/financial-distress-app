# ==============================================================================
# CONTOH KONFIGURASI DATABASE UNTUK STREAMLIT SECRETS
# ==============================================================================
# Gunakan file ini sebagai panduan saat hosting website ke Streamlit Community Cloud,
# Railway, Render, atau VPS Anda.
#
# Salin isi file ini ke:
# 1. Lokal: .streamlit/secrets.toml (JANGAN commit ke GitHub!)
# 2. Streamlit Cloud: App Settings -> Secrets
# ==============================================================================

# OPSI A: Menggunakan Connection String Langsung (Rekomendasi: Neon.tech / Supabase)
DATABASE_URL = "postgresql://user:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require"

# OPSI B: Format Streamlit SQL Connection (Opsional)
# [connections.postgresql]
# dialect = "postgresql"
# host = "ep-sample-host.us-east-2.aws.neon.tech"
# port = 5432
# database = "neondb"
# username = "user"
# password = "password"
# url = "postgresql://user:password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require"
