# ==============================================================================
# KONFIGURASI SUPABASE & DATABASE UNTUK STREAMLIT SECRETS
# ==============================================================================
# Salin file ini menjadi: .streamlit/secrets.toml (di laptop)
# Atau tempel langsung di dashboard hosting: Streamlit Cloud -> Settings -> Secrets
# PENTING: JANGAN PERNAH meng-commit file secrets.toml asli ke Git / GitHub publik!
# ==============================================================================

# 1. Kredensial Supabase Project (Wajib untuk Supabase Auth & PostgreSQL)
# Dapatkan dari: Dashboard Supabase -> Project Settings -> API
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# 2. Supabase Service Role Key (HANYA digunakan untuk script bootstrap admin lokal)
# PENTING: JANGAN PERNAH menyebarkan key ini ke aplikasi publik / frontend!
# SUPABASE_SERVICE_ROLE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# 3. Connection String PostgreSQL Langsung (Opsional / untuk koneksi SQL direct)
# Dapatkan dari: Dashboard Supabase -> Project Settings -> Database -> Connection String (URI)
# DATABASE_URL = "postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"
