                f"({coeff.get('X3',0):.4f}×X3) + ({coeff.get('X4',0):.4f}×X4)"
            )
            if "X5" in coeff:
                formula += f" + ({coeff.get('X5',0):.4f}×X5)"
            
            st.code(formula, language="text")
            st.dataframe(pd.DataFrame([[
                mda, mda_cls.upper(), f"{config['mda_threshold']:.4f}"
            ]], columns=["Z-Score Baru", "Klasifikasi", "Cut-off Objektif"]), use_container_width=True, hide_index=True)
        
