# ---------- Database Setup (SQLite) ----------
def init_db():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    # Tabel Pengguna (Users)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            username TEXT PRIMARY KEY,
            password TEXT,
            role TEXT
        )
    """)
    # Masukkan akun default jika belum ada
    cursor.execute("INSERT OR IGNORE INTO users VALUES ('admin', 'admin123', 'admin')")
    cursor.execute("INSERT OR IGNORE INTO users VALUES ('user', 'user123', 'user')")

    # Tabel Riwayat Prediksi
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS predictions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT,
            company TEXT,
            ticker TEXT,
            year INTEGER,
            z_score REAL,
            z_cls TEXT,
            mda_score REAL,
            mda_cls TEXT,
            xgb_prob REAL,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    """)
    conn.commit()
    conn.close()

init_db()

def verify_user(username, password):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("SELECT role FROM users WHERE username = ? AND password = ?", (username, password))
    res = cursor.fetchone()
    conn.close()
    return res[0] if res else None

def save_prediction_to_db(username, company, ticker, year, z, z_cls, mda, mda_cls, xgb_prob):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        INSERT INTO predictions (username, company, ticker, year, z_score, z_cls, mda_score, mda_cls, xgb_prob)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (username, company, ticker, year, z, z_cls, mda, mda_cls, xgb_prob))
    conn.commit()
    conn.close()

